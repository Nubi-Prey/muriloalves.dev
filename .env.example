# GitHub API Token (Optional for local dev / offline builds; recommended for production ISR)
GITHUB_TOKEN=

# Secret token for On-Demand ISR Revalidation endpoint: /api/revalidate?secret=...
REVALIDATE_SECRET=change-this-to-a-secure-random-secret

# Cache TTL in seconds for ISR (default: 86400 = 24 hours)
REVALIDATE_SECONDS=86400

# GitHub Username whose pinned repositories will be fetched (default: Nubi-Prey)
GITHUB_USERNAME=Nubi-Prey
